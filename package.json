{
  "name": "called-and-sent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api": "wrangler pages functions build --outdir dist && vitest run -c vitest.workers.config.ts",
    "cf-typegen": "wrangler types",
    "d1:migrate": "wrangler d1 migrations apply called-and-sent",
    "pages:dev": "wrangler pages dev dist",
    "cf:deploy": "wrangler pages deploy dist --project-name called-and-sent"
  },
  "dependencies": {
    "@neondatabase/auth-ui": "^0.2.1-beta",
    "@neondatabase/neon-js": "^0.6.2-beta",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.544.0",
    "mapbox-gl": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-map-gl": "^7.1.9",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^5.4.20",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "core-js@3.49.0": true,
    "workerd@1.20260801.1": true
  }
}
